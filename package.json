{
  "name": "kaamset",
  "version": "1.0.0",
  "description": "KaamSet: multilingual GenAI companion for gig and informal workers",
  "scripts": {
    "dev": "vite",
    "dev:worker": "wrangler dev",
    "typecheck": "tsc -p .",
    "lint": "biome lint .",
    "build": "tsc -p . && vite build",
    "test": "node --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "eval:live": "node tests/live/eval.ts",
    "preview": "npm run build && wrangler dev",
    "check:deploy": "npm run build && wrangler deploy --dry-run --outdir .wrangler/dry-run",
    "deploy": "npm run build && wrangler deploy",
    "check": "npm run typecheck && npm run lint && npm test && npm run build"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "lucide-react": "^1.58.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@biomejs/biome": "^2.5.15",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "wrangler": "^4.151.1"
  },
  "private": true,
  "engines": {
    "node": ">=22.18.0"
  }
}
